# Server only. Never use a VITE_ prefix for these values.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://cc_runtime:CHANGE_ME@localhost:5432/carboncanvas
MIGRATION_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/carboncanvas
DATABASE_SSL=false
# Production: true; optional PEM root certificate for Supabase certificate validation.
DATABASE_CA_FILE=
DB_POOL_MAX=5
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
BETTER_AUTH_URL=http://localhost:3001
FRONTEND_ORIGIN=http://localhost:5173
# Empty unless behind explicitly trusted reverse proxy CIDRs. Never use true or a hop count.
TRUSTED_PROXY_CIDRS=
SMTP_URL=smtps://username:password@smtp.example.com:465
EMAIL_FROM=CarbonCanvas <study@example.com>
# Independent 64-character hex key. Retain during rotation until queued mail drains.
EMAIL_ENCRYPTION_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
GEMINI_API_KEY=REPLACE_WITH_ROTATED_SERVER_ONLY_KEY
GEMINI_MODEL=gemini-3.8-flash
