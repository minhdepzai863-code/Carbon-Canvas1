{
  "name": "carboncanvas-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env.local src/server.js",
    "dev": "node --env-file-if-exists=.env.local --watch src/server.js",
    "migrate": "node --env-file-if-exists=.env.local scripts/migrate.js",
    "configure-runtime-role": "node --env-file-if-exists=.env.local scripts/configure-runtime-role.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "mail-worker": "node --env-file-if-exists=.env.local scripts/mail-worker.js",
    "cleanup": "node --env-file-if-exists=.env.local scripts/cleanup.js"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "cors": "2.8.6",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "nodemailer": "10.1.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "embedded-postgres": "18.4.0-beta.17"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true
  }
}
